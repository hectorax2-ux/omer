{
  "name": "art-atlas",
  "version": "1.0.4",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components constants data features hooks providers services src types utils",
    "test:home-engines": "npx --yes tsx script/verify-home-engines.ts",
    "test:gallery-filters": "bun run script/verify-gallery-filters.ts",
    "deploy:firestore": "npx firebase-tools deploy --only firestore:rules,firestore:indexes",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "build:ios:production": "npx eas-cli build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.7",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.8",
    "expo-iap": "4.3.5",
    "expo-image": "~3.0.10",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-tracking-transparency": "~6.0.8",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^15.8.3",
    "react-native-nitro-google-signin": "^1.3.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin"
        ]
      }
    }
  }
}
